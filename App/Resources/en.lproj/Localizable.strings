/* ==========================================================================
   Localizable.strings — base (English).

   Every user-facing SwiftUI string flows through LocalizedStringKey, so it
   resolves against this table; a missing key falls back to the literal, so
   this file is the translator source rather than a correctness dependency.
   Interpolated keys use the SwiftUI-generated format specifiers (%@, %lld).
   ========================================================================== */

/* --- Push notifications (consumed by CloudKit's localized push + the NSE) --- */
/* Notification title shown by CloudKit's localized push. %@ = sender name. */
"ATTENTION_NOTIFICATION_TITLE" = "%@";
/* Notification body. %1$@ = sender name, %2$@ = message. */
"ATTENTION_NOTIFICATION_BODY" = "%1$@ %2$@";

