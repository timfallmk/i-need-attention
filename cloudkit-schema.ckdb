DEFINE SCHEMA
    /* PairProfile is what one person tells their partner about themselves: it is
       written into the partner's inbox zone, which only an accepted share participant
       can reach. It closes the pairing handshake on its first write (carrying the
       joiner's share back) and carries display-name changes after that. Private-database
       record types need no grants — zone membership is the access control, which is the
       whole point of the 2.0 move. The name and share URL are ciphertext for the same
       reason the alert fields are. */
    RECORD TYPE PairProfile (
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,

        deviceID         STRING,
        nameSealed       BYTES,
        shareURLSealed   BYTES
    );

    /* AlertStatus is the receiver telling the sender what they did with an alert. It
       is written into the sender's own inbox zone rather than as an update to the
       alert, because the alert lives in the receiver's zone and CloudKit allows only
       CKDatabaseSubscription in the shared database — those notifications name a
       database, not a record, so nothing could turn one into a banner. A record in the
       sender's own zone is reachable by an ordinary private-database query
       subscription. The Alert record stays canonical; this exists to be pushed.
       `state` is queryable so the ack subscription can filter to the one that deserves
       a visible banner. */
    RECORD TYPE AlertStatus (
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,

        alertRecordName  STRING,
        state            STRING QUERYABLE,
        ackEmojiSealed   BYTES
    );

    RECORD TYPE Alert (
        "___createTime"  TIMESTAMP SORTABLE,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,

        pairKey          STRING QUERYABLE SORTABLE,
        senderDeviceID   STRING QUERYABLE,
        senderName       STRING,
        message          STRING,
        state            STRING QUERYABLE,
        ackEmoji         STRING,
        seenAt           TIMESTAMP,
        acknowledgedAt   TIMESTAMP,
        critical         INT64,

        /* 2.0 ciphertext. New names rather than a changed type on the three plaintext
           fields above: a record type's schema is container-wide, and pre-2.0 records
           still have to parse. Not queryable — nothing filters on ciphertext, and the
           records live in private zones where the zone is the filter. */
        senderNameSealed BYTES,
        messageSealed    BYTES,
        ackEmojiSealed   BYTES,

        GRANT READ TO "_icloud",
        GRANT WRITE TO "_icloud",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE Ack (
        "___createTime"     TIMESTAMP,
        "___createdBy"      REFERENCE,
        "___etag"           STRING,
        "___modTime"        TIMESTAMP,
        "___modifiedBy"     REFERENCE,
        "___recordID"       REFERENCE,

        pairKey             STRING QUERYABLE,
        recipientDeviceID   STRING QUERYABLE,
        emoji               STRING,
        alertRecordName     STRING,

        GRANT READ TO "_icloud",
        GRANT WRITE TO "_icloud",
        GRANT CREATE TO "_icloud"
    );
